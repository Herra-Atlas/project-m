{
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-inner-size",
    "core:window:allow-inner-position",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "dialog:default",
    "dialog:allow-open",
    "shell:default",
    "shell:allow-open",
    "updater:default"
  ]
}
