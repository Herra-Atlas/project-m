{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project M",
  "version": "0.2.1",
  "identifier": "com.herra-atlas.project-m",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:43125",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Project M",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "category": "Productivity",
    "shortDescription": "Visual macro builder for Windows",
    "longDescription": "Project M is a node-graph macro builder for Windows. Design automations visually and run them with a single click.",
    "publisher": "Herra-Atlas",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../tools/ipc-listener/ipc_listener.exe",
      "../tools/ipc-listener/ipc_listener.ahk"
    ]
  }
}